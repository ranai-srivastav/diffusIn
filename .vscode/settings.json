{
  "python.analysis.extraPaths": [
    "${workspaceFolder}/include",
    "${workspaceFolder}/include/act",
    "${workspaceFolder}/include/diffusion_policy",
    "${workspaceFolder}/include/OpenVision/src"
  ],
  "python.envFile": "${workspaceFolder}/.vscode/.env",
  "python.linting.pylintEnabled": true,
  "python.linting.enabled": true,
  "pylint.args": [
    "--init-hook",
    "import sys, os; p=os.environ.get('PYTHONPATH','');\n[sys.path.append(s) for s in p.split(os.pathsep) if s]"
  ],
  "workbench.colorCustomizations": {
    "activityBar.background": "#361774",
    "titleBar.activeBackground": "#4C21A2",
    "titleBar.activeForeground": "#FDFCFE"
  }
}